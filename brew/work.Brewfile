# Development and Yandex work tools. Install after base.
tap "anomalyco/tap"
tap "derailed/k9s"
tap "yandex/arc", "https://arc-vcs.yandex-team.ru/homebrew-tap"

brew "ansible"
brew "ansible-lint"
brew "awscli"
brew "colima"
brew "docker"
brew "docker-compose"
brew "docker-credential-helper"
brew "gettext"
brew "go"
brew "go-task"
brew "grpcurl"
brew "helm"
brew "helmfile"
brew "kind"
brew "kubernetes-cli"
brew "kubectx"
brew "kustomize"
brew "node"
brew "pnpm"
brew "tfenv"
brew "yq"
brew "anomalyco/tap/opencode", trusted: true
brew "derailed/k9s/k9s", trusted: true
brew "yandex/arc/arc-launcher"

cask "claude-code"
cask "codex"
cask "visual-studio-code"
cask "yandex-cloud-cli"

vscode "4ops.terraform"
vscode "docker.docker"
vscode "golang.go"
vscode "ms-kubernetes-tools.vscode-kubernetes-tools"
vscode "ms-python.python"
vscode "perseus.vscode-yandex-arc"
vscode "redhat.vscode-yaml"

npm "@deepseek-ai/dsh"
